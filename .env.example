# 服务端配置；复制为 .env，仅本机保存。不要把真实密钥写入 VITE_ 变量。
API_HOST=127.0.0.1
API_PORT=8787
DATABASE_PATH=server/data/qingyu.sqlite
WECHAT_APP_ID=wxdccead0ec32190d0
WECHAT_APP_SECRET=
ALLOW_DEV_LOGIN=false
TRUST_LOCAL_PROXY=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 可选 AI：OpenAI 兼容 Chat Completions 的完整 HTTPS 地址；四项齐全才启用。
# 由用户指定供应商后配置；标签会展示给用户，密钥仅服务端读取。
AI_API_ENDPOINT=
AI_API_KEY=
AI_MODEL=
AI_PROVIDER_LABEL=
AI_TIMEOUT_MS=30000
# 滚动 24 小时每账号请求技术上限（含失败/取消），不是会员商业额度。
AI_DAILY_LIMIT=20

# 前端公开地址默认由 config/public-api.json 按构建模式选择。
# 仅独立本机联调时取消下一行注释；显式覆盖也会影响 production 构建。
# VITE_API_BASE_URL=http://127.0.0.1:8787
