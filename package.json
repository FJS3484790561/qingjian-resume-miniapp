{
  "name": "qingjian-resume-prototypes",
  "version": "0.4.0",
  "private": true,
  "description": "轻简履微信小程序 · 青屿前端与后端联调",
  "scripts": {
    "dev": "uni --host 127.0.0.1 --port 5173",
    "build:h5": "uni build",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "wechat:open": "powershell -NoProfile -File scripts/open-wechat-testing.ps1",
    "type-check": "vue-tsc --noEmit",
    "test": "node --test --test-concurrency=1 scripts/test-*.cjs",
    "server:dev": "node --experimental-sqlite --import tsx server/index.ts --dev",
    "server:start": "node --experimental-sqlite --import tsx server/index.ts",
    "server:type-check": "tsc --project server/tsconfig.json",
    "test:server": "node --experimental-sqlite --import tsx --test --test-concurrency=1 server/tests/*.test.ts",
    "test:render": "node --experimental-sqlite --import tsx server/qa/verify-exports.ts",
    "server:build": "node scripts/build-server.mjs",
    "server:production": "node --experimental-sqlite dist/server/index.cjs",
    "test:bundle": "node scripts/smoke-server-bundle.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "docx": "9.14.0",
    "fastify": "5.12.7",
    "htmlparser2": "12.0.0",
    "playwright": "1.64.1",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "vue": "3.5.44",
    "wot-design-uni": "1.14.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@types/node": "22.20.5",
    "@types/sanitize-html": "2.16.2",
    "@vue/runtime-core": "3.5.44",
    "esbuild": "0.28.2",
    "sass": "1.105.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "@dcloudio/vite-plugin-uni": {
      "vite": "$vite"
    }
  }
}
