# 目标机独立文件 /etc/qingyu/api.env；用户本人配置密钥；真实文件不得提交。
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=8790
DATABASE_PATH=/var/lib/qingyu/qingyu.sqlite
WECHAT_APP_ID=wxdccead0ec32190d0
WECHAT_APP_SECRET=
ALLOW_DEV_LOGIN=false
# Only the local Nginx proxy may supply client IPs; it replaces X-Forwarded-For.
TRUST_LOCAL_PROXY=true
# 留空表示无浏览器跨域来源；微信原生请求不需要 CORS。
CORS_ORIGINS=
AI_API_ENDPOINT=
AI_API_KEY=
AI_MODEL=
AI_PROVIDER_LABEL=
AI_TIMEOUT_MS=30000
AI_DAILY_LIMIT=20
