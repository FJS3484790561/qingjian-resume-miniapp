[Unit]
Description=Qingyu Resume API (independent instance)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qingyu
Group=qingyu
WorkingDirectory=/opt/qingyu/current
Environment=NODE_ENV=production
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/qingyu/browsers
EnvironmentFile=/etc/qingyu/api.env
ExecStart=/usr/bin/node --max-old-space-size=256 --experimental-sqlite /opt/qingyu/current/dist/server/index.cjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
StateDirectory=qingyu
StateDirectoryMode=0700
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/qingyu
MemoryHigh=650M
MemoryMax=850M
CPUQuota=100%
TasksMax=160

[Install]
WantedBy=multi-user.target
